# ==============================================================================
# NEORA ALUSYS — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure your production credentials.
# Do NOT commit your actual .env file with private credentials to git.

PORT=3000

# SMTP Email Service Configuration
# Required to send website enquiries directly to Inquiry@neoraalusys.it
SMTP_HOST=smtp.your-mail-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username-or-email
SMTP_PASS=your-smtp-password-or-app-key
SMTP_FROM="NEORA Alusys" <Inquiry@neoraalusys.it>

# Target recipient for all website enquiries (default: Inquiry@neoraalusys.it)
ENQUIRY_RECIPIENT=Inquiry@neoraalusys.it

